[Unit]
Description=Alpaca Hack isolated TrueForge agent server
After=network-online.target alpaca-hack-research.service alpaca-hack-alpaca-mcp.service
Wants=network-online.target alpaca-hack-research.service alpaca-hack-alpaca-mcp.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=alpaca-hack
Group=alpaca-hack
WorkingDirectory=/opt/alpaca-hack/mandate/trueforge
EnvironmentFile=/etc/alpaca-hack/alpaca-hack.env
Environment=HOME=/opt/alpaca-hack
Environment=TMPDIR=/run/alpaca-hack-trueforge
Environment=PORT=8890
Environment=NODE_ENV=production
RuntimeDirectory=alpaca-hack-trueforge
RuntimeDirectoryMode=0700
ExecStart=/opt/alpaca-hack/mandate/trueforge/node_modules/.bin/trueforge --port 8890
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
