[Unit]
Description=Alpaca Hack official Alpaca MCP server (paper account, loopback only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=alpaca-hack
Group=alpaca-hack
WorkingDirectory=/opt/alpaca-hack
EnvironmentFile=/etc/alpaca-hack/alpaca-hack.env
Environment=HOME=/opt/alpaca-hack
Environment=ALPACA_PAPER_TRADE=true
# Account/positions live in these upstream toolsets. The service remains
# loopback-only; runner and operator each apply their own explicit read allowlist.
Environment=ALPACA_TOOLSETS=account,trading,assets,stock-data
# The MCP server talks to Alpaca itself; honour the same outbound proxy as the
# runner when MANDATE_USE_ALPACA_PROXY=true. Install once with
# /opt/alpaca-hack/venv/bin/pip install alpaca-mcp-server
ExecStart=/bin/sh -c 'if [ "$MANDATE_USE_ALPACA_PROXY" = "true" ] && [ -n "$ALPACA_PROXY_URL" ]; then export HTTPS_PROXY="$ALPACA_PROXY_URL" HTTP_PROXY="$ALPACA_PROXY_URL"; fi; exec /opt/alpaca-hack/venv/bin/alpaca-mcp-server --transport streamable-http --host 127.0.0.1 --port 8100'
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
