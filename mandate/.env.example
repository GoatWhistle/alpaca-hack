# Paper trading only. Never commit real values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
MANDATE_SEC_USER_AGENT=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
MANDATE_USE_ALPACA_PROXY=false
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_NEWS_MODEL=glm-5.3-flash
MANDATE_PATH=./mandates/example.yaml
MANDATE_JOURNAL_PATH=./logs/session.jsonl
MANDATE_TRAJECTORY_PATH=./logs/trajectory.json
MANDATE_ALERTS_PATH=./logs/news-alerts.jsonl
MANDATE_AUTONOMY_RUNTIME_PATH=./logs/autonomy-runtime.json
MANDATE_NEWS_CURSOR_PATH=./logs/news-cursor.json
MANDATE_PYTHON=python3
MANDATE_MAX_POSITION_PCT=40
MANDATE_MAX_GROSS_EXPOSURE_PCT=100
MANDATE_MAX_DAILY_LOSS_PCT=10
MANDATE_DAILY_ENTRY_STOP_PCT=8
MANDATE_MAX_ORDERS_PER_DAY=10
MANDATE_REENTRY_COOLDOWN_MINUTES=10
MANDATE_ALLOW_SAME_DAY_REENTRY=false
MANDATE_REVERSAL_MIN_STRENGTH=0.20
MANDATE_EXECUTION_STATE_PATH=./logs/execution-state.json
MANDATE_IPO_MAX_POSITION_PCT=2
MANDATE_OPTIONS_ENABLED=true
MANDATE_OPTIONS_PER_CYCLE=1
MANDATE_OPTION_MIN_DTE=7
MANDATE_OPTION_MAX_DTE=21
MANDATE_OPTION_MAX_SPREAD_PCT=8
MANDATE_OPTION_MAX_SPREAD_ABS=0.15
MANDATE_OPTION_MAX_MONEYNESS_PCT=10
MANDATE_OPTION_RISK_PCT=1.5
MANDATE_OPTION_TOTAL_RISK_PCT=6
MANDATE_OPTION_STOP_LOSS_PCT=25
MANDATE_OPTION_PROFIT_TARGET_PCT=25
MANDATE_OPTION_EXIT_DTE=2
MANDATE_OPTION_TIME_STOP_MINUTES=120
MANDATE_OPTION_DEAD_BAND_PCT=10
MANDATE_EXIT_STOP_ATR=1.0
MANDATE_EXIT_TARGET_ATR=1.0
MANDATE_EXIT_TIME_STOP_MINUTES=120
MANDATE_EXIT_DEAD_POSITION_ATR=0.25
MANDATE_EXIT_ATR_TIMEFRAME=1Day
MANDATE_MACRO_PRICE_ENABLED=false
MANDATE_FILL_ATTEMPTS=3
MANDATE_FILL_WAIT_SECONDS=3
MANDATE_DATA_TIMEOUT_SECONDS=8
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=
MANDATE_AGENT_NAME=mandate-paper-agent
MANDATE_ALPACA_MCP_URL=http://127.0.0.1:8100/mcp
# Broker reads (account, positions) go through the Alpaca MCP server above; set false to force REST.
MANDATE_ALPACA_MCP_READS=true
MANDATE_CRITIC_TIMEOUT_SECONDS=20
MANDATE_STARTING_EQUITY=100000
MANDATE_RESEARCH_URL=http://127.0.0.1:8020/mcp
MANDATE_DASHBOARD_HOST=127.0.0.1
MANDATE_DASHBOARD_PORT=8030
MANDATE_RESEARCH_TRANSPORT=streamable-http
MANDATE_RESEARCH_HOST=127.0.0.1
MANDATE_RESEARCH_PORT=8020
